# Gemini API key from Google AI Studio (see "Get a Gemini API key" in the README).
# Put the SAME key in both variables: the first is read by the text generation, the second by the voice tutor.
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Passcode to gate access to the study workspace
APP_PASSCODE=your_secure_passcode_here

# Database connection URL (required for the Prisma commands)
DATABASE_URL=file:./dev.db

# Optional: where uploaded files are stored (default: web/storage)
# STORAGE_DIR=./storage

# Optional (default off): set to 1 to enrich imported questions in the background at session start. Spends up to 8 model calls per session start.
ENRICH_IN_BACKGROUND=0
