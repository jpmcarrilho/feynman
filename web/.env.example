# Google AI API Key (required for Gemini model integration and voice chat)
GOOGLE_API_KEY=your_google_api_key_here

# Passcode to gate access to the study workspace
APP_PASSCODE=your_secure_passcode_here

# Database connection URL (Required for Prisma CLI commands)
DATABASE_URL=file:./dev.db

# Optional (default off): set to 1 to enrich imported questions in the background at session start. Spends up to 8 model calls per session start.
ENRICH_IN_BACKGROUND=0
