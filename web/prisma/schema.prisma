generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  topics      Topic[]
}

model Topic {
  id           String     @id @default(uuid())
  courseId     String
  
  // --- NEW HIERARCHY FIELDS ---
  week         String?  // e.g., "Week 01"
  className    String?  // e.g., "Introduction to Political Economy"
  unit         String?  // e.g., "1"
  title        String   // Unit Title, e.g., "Intro to Political Economy part1"
  
  // --- CONTENT DETAILS ---
  resourceType String?  // e.g., "Video", "Slides PDF", "Exercise"
  content      String?   // The actual extracted text from the file
  localPath    String?  // Keep track of the original file path

  course       Course     @relation(fields: [courseId], references: [id])
  exercises    Exercise[]
}

model Exercise {
  id            String        @id @default(uuid())
  topicId       String
  questionText  String
  exerciseType  String        @default("single_choice") // "single_choice", "multiple_choice", "numeric", "dropdown"
  choices       String        // Stored as JSON string
  correctAnswer String
  explanation   String?
  topic         Topic         @relation(fields: [topicId], references: [id])
  logs          ExerciseLog[]
}

model StudySession {
  id          String        @id @default(uuid())
  title       String?       // e.g., "JPAL102x - Week 4"
  startTime   DateTime      @default(now())
  endTime     DateTime?
  status      String        // e.g., "active", "completed"
  chatLog     String?       // JSON string of chat messages
  exerciseIds String?       // JSON array of exercise IDs selected for this session
  logs        ExerciseLog[]
}

model ExerciseLog {
  id         String       @id @default(uuid())
  sessionId  String
  exerciseId String
  isCorrect  Boolean
  userAnswer String?      // The exact choice selected by the user
  duration   Int          // Time taken in seconds
  timestamp  DateTime     @default(now())
  session    StudySession @relation(fields: [sessionId], references: [id])
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])
}
