generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  topics      Topic[]
}

model Topic {
  id           String     @id @default(uuid())
  courseId     String
  
  // --- NEW HIERARCHY FIELDS ---
  week         String?  // e.g., "Week 01"
  className    String?  // e.g., "Introduction to Political Economy"
  unit         String?  // e.g., "1"
  title        String   // Unit Title, e.g., "Intro to Political Economy part1"
  
  // --- CONTENT DETAILS ---
  resourceType String?  // e.g., "Video", "Slides PDF", "Exercise"
  content      String?   // The actual extracted text from the file
  localPath    String?  // Keep track of the original file path

  course       Course     @relation(fields: [courseId], references: [id])
  exercises    Exercise[]
}

model Exercise {
  id            String        @id @default(uuid())
  topicId       String
  questionText  String
  exerciseType  String        @default("single_choice") // "single_choice", "multiple_choice", "numeric", "dropdown"
  choices       String        // Stored as JSON string
  correctAnswer String
  explanation   String?
  topic         Topic         @relation(fields: [topicId], references: [id])
  logs          ExerciseLog[]
}

model StudySession {
  id           String        @id @default(uuid())
  title        String?       // e.g., "JPAL102x - Week 4"
  startTime    DateTime      @default(now())
  endTime      DateTime?
  status       String        // e.g., "active", "completed"
  mode         String        @default("study") // "study" or "exam"
  timeLimit    Int?          // Time limit in seconds (e.g., 4500 for 1h15m)
  draftAnswers String?       // JSON string mapping exerciseId -> user's draft answer
  flaggedIds   String?       // JSON array of exercise IDs flagged for review
  sourcingMix  Int           @default(50) // % of AI generated questions (0 to 100)
  diagnosis    String?       // Markdown of the analytical diagnosis report
  chatLog      String?       // JSON string of chat messages
  exerciseIds  String?       // JSON array of exercise IDs selected for this session
  studyPlanId  String?       // Link to the parent curriculum study plan
  studyPlan    StudyPlan?    @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  logs         ExerciseLog[]
}

model StudyPlan {
  id               String         @id @default(uuid())
  title            String         // e.g., "DEDP 5-Day Exam Sprint"
  executiveSummary String         // Analytical summary compiled by Gemini
  status           String         @default("active") // "active", "completed", "archived"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         StudySession[] // Pre-created timeline of sessions
}

model ExerciseLog {
  id         String       @id @default(uuid())
  sessionId  String
  exerciseId String
  isCorrect  Boolean
  userAnswer String?      // The exact choice selected by the user
  duration   Int          // Time taken in seconds
  timestamp  DateTime     @default(now())
  session    StudySession @relation(fields: [sessionId], references: [id])
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])
}
